<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The project file uses the Clean Architecture layer name
         (Presentation.Blazor, alongside Domain, Application, and
         Infrastructure under src/). The assembly, namespace, and NuGet
         package use the shorter PhosphorIcons.Blazor identity to match
         the .NET Blazor icon library convention on nuget.org. -->
    <AssemblyName>PhosphorIcons.Blazor</AssemblyName>
    <RootNamespace>PhosphorIcons.Blazor</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package identity -->
  <PropertyGroup>
    <PackageId>PhosphorIcons.Blazor</PackageId>
    <Version>0.1.0</Version>
    <Authors>phosphor-icons-blazor contributors</Authors>
    <Description>Phosphor Icons for Blazor. 1248 icons across 6 weights (thin, light, regular, bold, fill, duotone) as native Razor components, in both per-icon (&lt;PhosphorIcons.House /&gt;) and dynamic (&lt;PhosphorIcon Name="house" /&gt;) forms. Pinned to upstream phosphor-icons/core v2.0.8.</Description>
    <PackageTags>phosphor;icons;blazor;svg;components;ui;razor</PackageTags>
    <PackageProjectUrl>https://github.com/matuskam/phosphor-icons-blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/matuskam/phosphor-icons-blazor.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Best practices: symbols, deterministic, SourceLink -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Bundle PDBs and XML docs of the referenced inner-layer projects into the package.
       Without this, CopyProjectReferencesToPackage only carries .dll files: the symbol
       package would have no PDBs for Domain/Application/Infrastructure (debugger source-
       stepping breaks at the inner-DLL boundary), and IntelliSense would have no XML
       comments for any inner-layer public type. -->
  <PropertyGroup>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb;.xml</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <!-- Bundle the inner-layer DLLs into this single NuGet package -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Per-TFM Blazor framework reference -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <!-- SourceLink (build-time only, doesn't leak as a runtime dependency) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Inner-layer projects: bundled into the package, not exposed as NuGet dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\PhosphorIcons.Infrastructure\PhosphorIcons.Infrastructure.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PhosphorIcons.Application\PhosphorIcons.Application.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\PhosphorIcons.Domain\PhosphorIcons.Domain.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- Files packed into the .nupkg root -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Copy inner-layer DLLs into the package's lib/<tfm>/ folder -->
  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

</Project>
