<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Emit XML documentation alongside each DLL so consumers get IntelliSense for
         every type, including those in the inner Domain/Application/Infrastructure
         assemblies that ship bundled inside the single PhosphorIcons.Blazor.nupkg. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- CS1591: missing XML documentation comment for public type or member.
         The consumer-facing API surface is documented; internal helpers,
         the IsExternalInit polyfills, and the auto-generated icon classes
         are not, and CS1591 would otherwise produce thousands of warnings
         per build. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
